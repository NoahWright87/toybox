{
  "name": "toybox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "games/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @toybox/shmup && tsc -b && vite build",
    "build:doors": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "jimp": "^0.22.12",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
